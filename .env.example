# --- GitHub (only needed for real PRs) ---
GITHUB_TOKEN=

# --- LLM provider (only needed for real PRs) ---
# openai | anthropic | mock            (mock = offline fixture responses)
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o
# OPENAI_API_KEY=

# Anthropic
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-4-20250514

# Any OpenAI-compatible endpoint (DeepSeek / MiMo / local vLLM ...)
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-...

# --- Offline demo / tests (no token, no key, no network) ---
# CODEWATCHER_GITHUB=fake
# CODEWATCHER_FIXTURE_DIR=fixtures/pr-101
# MOCK_LLM_FIXTURE=fixtures/pr-101/mock_llm.json

# --- Optional ---
# Persist checkpoints so a paused run can be resumed from another process
# CODEWATCHER_SQLITE_CHECKPOINT=.codewatcher/checkpoints.sqlite
